# Copy this file to .env and fill in your keys. Never commit .env.

# Gemini API key from https://aistudio.google.com (Get API key)
GOOGLE_API_KEY=your_gemini_key_here

# Optional: override the model used by the Python app
GEMINI_MODEL=gemini-3.8-flash

# Langfuse keys from your project settings at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# EU region (default). US region: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
